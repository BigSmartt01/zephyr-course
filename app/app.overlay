/{
	aliases {
		app-led = &led0;
	};
	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		};
	};
	our_driver0: our_driver {
		compatible = "our,driver";
		status = "okay";
	};
	our_driver1: our_driver1 {
		compatible = "our,driver";
		status = "okay";
	};
};
